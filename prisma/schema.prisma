generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDATE
  ADMIN
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model User {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  email           String    @unique
  password        String?
  image           String?
  role            Role      @default(CANDIDATE)
  experienceLevel String?
  targetRole      String?
  skills          String[]
  resumeUrl       String?
  streak          Int       @default(0)
  lastActiveDate  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions     InterviewSession[]
  notes        Note[]
  accounts     Account[]
  practiceSets PracticeSet[]
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Track {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  difficulty  Difficulty @default(INTERMEDIATE)
  icon        String?
  isPublished Boolean    @default(true)
  createdBy   String     @db.ObjectId
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  questions Question[]
  sessions  InterviewSession[]
}

model Question {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  trackId    String     @db.ObjectId
  question   String
  category   String
  difficulty Difficulty @default(INTERMEDIATE)
  tags       String[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  track   Track             @relation(fields: [trackId], references: [id], onDelete: Cascade)
  answers InterviewAnswer[]
}

model InterviewSession {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  userId        String        @db.ObjectId
  trackId       String?       @db.ObjectId
  practiceSetId String?       @db.ObjectId
  status        SessionStatus @default(IN_PROGRESS)
  overallScore  Float?
  aiSummary     String?
  weakAreas     String[]
  strongAreas   String[]
  startedAt     DateTime      @default(now())
  completedAt   DateTime?

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  track       Track?            @relation(fields: [trackId], references: [id])
  practiceSet PracticeSet?      @relation(fields: [practiceSetId], references: [id])
  answers     InterviewAnswer[]
}

model InterviewAnswer {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionId          String   @db.ObjectId
  questionId         String?  @db.ObjectId
  practiceQuestionId String?  @db.ObjectId
  answer             String
  score              Float?
  feedback           String?
  suggestions        String[]
  createdAt          DateTime @default(now())

  session          InterviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question         Question?         @relation(fields: [questionId], references: [id])
  practiceQuestion PracticeQuestion? @relation(fields: [practiceQuestionId], references: [id])
}

model PracticeSet {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  title          String
  jobDescription String
  resumeText     String
  createdAt      DateTime @default(now())

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions PracticeQuestion[]
  sessions  InterviewSession[]
}

model PracticeQuestion {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  practiceSetId String     @db.ObjectId
  question      String
  category      String
  difficulty    Difficulty @default(INTERMEDIATE)
  tags          String[]
  createdAt     DateTime   @default(now())

  practiceSet PracticeSet       @relation(fields: [practiceSetId], references: [id], onDelete: Cascade)
  answers     InterviewAnswer[]
}

model Note {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  title     String
  content   String
  tags      String[]
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
